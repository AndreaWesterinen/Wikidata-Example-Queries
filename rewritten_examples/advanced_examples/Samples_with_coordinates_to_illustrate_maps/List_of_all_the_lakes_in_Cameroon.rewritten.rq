# rewrite_status: rewritten
#defaultView:Map
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  schema: <http://schema.org/>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?itemLabel ?itemDescription ?image ?coord
WHERE
  { ?item wdt:P31/(wdt:P279)* wd:Q23397 .
    ?item  wdt:P17   wd:Q1009 ;
           wdt:P625  ?coord
    OPTIONAL
      { ?item  wdt:P18  ?image }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "en" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    BIND(if(bound(?item__label_value), ?item__label_value, if(( isURI(?item) && strstarts(str(?item), "http://www.wikidata.org/entity/") ), strafter(str(?item), "entity/"), str(?item))) AS ?itemLabel)
    OPTIONAL
      { ?item  schema:description  ?item__description_value
        FILTER ( lang(?item__description_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?item  schema:description  ?item__description_value
        FILTER ( lang(?item__description_value) = "en" )
      }
    BIND(?item__description_value AS ?itemDescription)
  }

# Original query:
# #defaultView:Map
# SELECT ?itemLabel ?itemDescription ?image ?coord WHERE {
#   ?item (wdt:P31/wdt:P279*) wd:Q23397.
#   ?item wdt:P17 wd:Q1009.
#   ?item wdt:P625 ?coord.
#   OPTIONAL {?item wdt:P18 ?image.}
#   SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
# }
