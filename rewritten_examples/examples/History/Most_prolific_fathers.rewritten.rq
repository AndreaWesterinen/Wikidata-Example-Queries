# rewrite_status: rewritten
#title: Most prolific fathers
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

WITH %get_fathers AS {
{ SELECT ?father (COUNT(?father) AS ?children)
  WHERE
  {
    ?subj wdt:P22 ?father .
  }
  GROUP BY ?father
  ORDER BY DESC(?children)
  LIMIT 50 }
}
SELECT  ?father ?fatherLabel (SAMPLE(?picture_) AS ?picture) ?children
WHERE
  { { SELECT ?father ?children WHERE { INCLUDE %get_fathers } }OPTIONAL
      { ?father  wdt:P18  ?picture_ }
    BIND(if(bound(?father), ?father, "unbound") AS ?father__label_subject)
    OPTIONAL
      { ?father__label_subject
                  rdfs:label  ?father__label_value
        FILTER ( lang(?father__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?father__label_subject
                  rdfs:label  ?father__label_value
        FILTER ( lang(?father__label_value) = "mul" )
      }
    OPTIONAL
      { ?father__label_subject
                  rdfs:label  ?father__label_value
        FILTER ( lang(?father__label_value) = "en" )
      }
    BIND(if(bound(?father__label_value), ?father__label_value, if(( isURI(?father) && strstarts(str(?father), "http://www.wikidata.org/entity/") ), strafter(str(?father), "entity/"), str(?father))) AS ?fatherLabel)
  }
GROUP BY ?father ?fatherLabel ?children
ORDER BY DESC(?children)

