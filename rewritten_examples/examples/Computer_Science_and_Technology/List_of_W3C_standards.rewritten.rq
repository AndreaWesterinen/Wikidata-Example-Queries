# rewrite_status: rewritten
#title: List of W3C standards
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT DISTINCT  ?standard ?standardLabel ?website
WHERE
  { ?standard  wdt:P1462  wd:Q37033
    OPTIONAL
      { ?standard  wdt:P856  ?website }
    OPTIONAL
      { ?standard  rdfs:label  ?standard__label_value
        FILTER ( lang(?standard__label_value) = "en" )
      }
    OPTIONAL
      { ?standard  rdfs:label  ?standard__label_value
        FILTER ( lang(?standard__label_value) = "mul" )
      }
    BIND(if(bound(?standard__label_value), ?standard__label_value, if(( isURI(?standard) && strstarts(str(?standard), "http://www.wikidata.org/entity/") ), strafter(str(?standard), "entity/"), str(?standard))) AS ?standardLabel)
  }
ORDER BY ?standardLabel

