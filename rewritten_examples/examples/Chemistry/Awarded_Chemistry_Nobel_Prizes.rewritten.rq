# rewrite_status: rewritten
#title: Awarded Chemistry Nobel Prizes
#defaultView:Timeline
PREFIX  p:    <http://www.wikidata.org/prop/>
PREFIX  pq:   <http://www.wikidata.org/prop/qualifier/>
PREFIX  ps:   <http://www.wikidata.org/prop/statement/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT DISTINCT  ?item ?itemLabel ?when (year(?when) AS ?date) ?pic
WHERE
  { ?item     p:P166   ?awardStat .
    ?awardStat  ps:P166  wd:Q44585 ;
              pq:P585  ?when
    OPTIONAL
      { ?item  wdt:P18  ?pic }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "en" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    BIND(if(bound(?item__label_value), ?item__label_value, if(( isURI(?item) && strstarts(str(?item), "http://www.wikidata.org/entity/") ), strafter(str(?item), "entity/"), str(?item))) AS ?itemLabel)
  }

# Original query:
# #title: Awarded Chemistry Nobel Prizes
# #defaultView:Timeline
# SELECT DISTINCT ?item ?itemLabel ?when (YEAR(?when) as ?date) ?pic
# WHERE {
#   ?item p:P166 ?awardStat .      # … with an awarded (P166) statement
#   ?awardStat ps:P166 wd:Q44585 . # … that has the value Nobel Prize in Chemistry (Q44585)
#   ?awardStat pq:P585 ?when .     # - when did they receive the Nobel prize
#
# SERVICE wikibase:label { bd:serviceParam wikibase:language "en" . }
# OPTIONAL { ?item wdt:P18 ?pic }
# }
