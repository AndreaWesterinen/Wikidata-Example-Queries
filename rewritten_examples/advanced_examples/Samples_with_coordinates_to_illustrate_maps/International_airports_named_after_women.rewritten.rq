# rewrite_status: rewritten
# Airports named after women
# List of airports that are named after women
# Written by WiseWoman auf der #wmdemv 2019
# defaultView:Map
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT DISTINCT  ?airport ?airportLabel ?coor ?namedafterLabel
WHERE
  { ?airport  wdt:P31   wd:Q644371 ;
              wdt:P625  ?coor ;
              wdt:P138  ?namedafter .
    ?namedafter  wdt:P31  wd:Q5 ;
              wdt:P21   wd:Q6581072
    OPTIONAL
      { ?airport  rdfs:label  ?airport__label_value
        FILTER ( lang(?airport__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?airport  rdfs:label  ?airport__label_value
        FILTER ( lang(?airport__label_value) = "en" )
      }
    OPTIONAL
      { ?airport  rdfs:label  ?airport__label_value
        FILTER ( lang(?airport__label_value) = "mul" )
      }
    BIND(if(bound(?airport__label_value), ?airport__label_value, if(( isURI(?airport) && strstarts(str(?airport), "http://www.wikidata.org/entity/") ), strafter(str(?airport), "entity/"), str(?airport))) AS ?airportLabel)
    OPTIONAL
      { ?namedafter  rdfs:label  ?namedafter__label_value
        FILTER ( lang(?namedafter__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?namedafter  rdfs:label  ?namedafter__label_value
        FILTER ( lang(?namedafter__label_value) = "en" )
      }
    OPTIONAL
      { ?namedafter  rdfs:label  ?namedafter__label_value
        FILTER ( lang(?namedafter__label_value) = "mul" )
      }
    BIND(if(bound(?namedafter__label_value), ?namedafter__label_value, if(( isURI(?namedafter) && strstarts(str(?namedafter), "http://www.wikidata.org/entity/") ), strafter(str(?namedafter), "entity/"), str(?namedafter))) AS ?namedafterLabel)
  }

# Original query:
