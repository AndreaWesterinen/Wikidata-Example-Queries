# rewrite_status: rewritten
#title: Most eponymous mathematicians
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?eponym ?eponymLabel ?count ?sample ?sampleLabel
WHERE
  { { SELECT  ?eponym (COUNT(?item) AS ?count) (SAMPLE(?item) AS ?sample)
      WHERE
        { ?item    wdt:P138  ?eponym .
          ?eponym  wdt:P106  wd:Q170790
        }
      GROUP BY ?eponym
    }
    OPTIONAL
      { ?eponym  rdfs:label  ?eponym__label_value
        FILTER ( lang(?eponym__label_value) = "en" )
      }
    OPTIONAL
      { ?eponym  rdfs:label  ?eponym__label_value
        FILTER ( lang(?eponym__label_value) = "mul" )
      }
    BIND(if(bound(?eponym__label_value), ?eponym__label_value, if(( isURI(?eponym) && strstarts(str(?eponym), "http://www.wikidata.org/entity/") ), strafter(str(?eponym), "entity/"), str(?eponym))) AS ?eponymLabel)
    BIND(if(bound(?sample), ?sample, "unbound") AS ?sample__label_subject)
    OPTIONAL
      { ?sample__label_subject
                  rdfs:label  ?sample__label_value
        FILTER ( lang(?sample__label_value) = "en" )
      }
    OPTIONAL
      { ?sample__label_subject
                  rdfs:label  ?sample__label_value
        FILTER ( lang(?sample__label_value) = "mul" )
      }
    BIND(if(bound(?sample__label_value), ?sample__label_value, if(( isURI(?sample) && strstarts(str(?sample), "http://www.wikidata.org/entity/") ), strafter(str(?sample), "entity/"), str(?sample))) AS ?sampleLabel)
  }
ORDER BY DESC(?count)

