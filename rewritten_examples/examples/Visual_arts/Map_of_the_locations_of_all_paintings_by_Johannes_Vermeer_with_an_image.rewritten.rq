# rewrite_status: rewritten
#title: Map of the locations of all paintings by Johannes Vermeer with an image
#defaultView:Map
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?painting ?paintingLabel ?location ?image
WHERE
  { ?painting  wdt:P276  ?collection ;
              wdt:P170  wd:Q41264 ;
              wdt:P18   ?image .
    ?collection  wdt:P625  ?location
    OPTIONAL
      { ?painting  rdfs:label  ?painting__label_value
        FILTER ( lang(?painting__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?painting  rdfs:label  ?painting__label_value
        FILTER ( lang(?painting__label_value) = "mul" )
      }
    OPTIONAL
      { ?painting  rdfs:label  ?painting__label_value
        FILTER ( lang(?painting__label_value) = "en" )
      }
    BIND(if(bound(?painting__label_value), ?painting__label_value, if(( isURI(?painting) && strstarts(str(?painting), "http://www.wikidata.org/entity/") ), strafter(str(?painting), "entity/"), str(?painting))) AS ?paintingLabel)
  }

