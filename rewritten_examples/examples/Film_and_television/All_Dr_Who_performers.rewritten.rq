# rewrite_status: rewritten
#title: All Dr. Who performers
#added 2017-07-16, updated 2020-07-08
PREFIX  p:    <http://www.wikidata.org/prop/>
PREFIX  ps:   <http://www.wikidata.org/prop/statement/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX  xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT  ?doctor ?doctorLabel ?ordinal ?performer ?performerLabel
WHERE
  { ?doctor  wdt:P31  wd:Q47543030
    OPTIONAL
      { ?doctor  wdt:P1545  ?ordinal }
    OPTIONAL
      { ?doctor p:P175/ps:P175 ?performer }
    OPTIONAL
      { ?doctor  rdfs:label  ?doctor__label_value
        FILTER ( lang(?doctor__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?doctor  rdfs:label  ?doctor__label_value
        FILTER ( lang(?doctor__label_value) = "mul" )
      }
    OPTIONAL
      { ?doctor  rdfs:label  ?doctor__label_value
        FILTER ( lang(?doctor__label_value) = "en" )
      }
    BIND(if(bound(?doctor__label_value), ?doctor__label_value, if(( isURI(?doctor) && strstarts(str(?doctor), "http://www.wikidata.org/entity/") ), strafter(str(?doctor), "entity/"), str(?doctor))) AS ?doctorLabel)
    BIND(if(bound(?performer), ?performer, "unbound") AS ?performer__label_subject)
    OPTIONAL
      { ?performer__label_subject
                  rdfs:label  ?performer__label_value
        FILTER ( lang(?performer__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?performer__label_subject
                  rdfs:label  ?performer__label_value
        FILTER ( lang(?performer__label_value) = "mul" )
      }
    OPTIONAL
      { ?performer__label_subject
                  rdfs:label  ?performer__label_value
        FILTER ( lang(?performer__label_value) = "en" )
      }
    BIND(if(bound(?performer__label_value), ?performer__label_value, if(( isURI(?performer) && strstarts(str(?performer), "http://www.wikidata.org/entity/") ), strafter(str(?performer), "entity/"), str(?performer))) AS ?performerLabel)
  }
ORDER BY ASC(xsd:integer(?ordinal))

