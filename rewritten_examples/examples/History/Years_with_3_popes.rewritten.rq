# rewrite_status: rewritten
#title: Years with 3 popes
PREFIX  p:    <http://www.wikidata.org/prop/>
PREFIX  pq:   <http://www.wikidata.org/prop/qualifier/>
PREFIX  ps:   <http://www.wikidata.org/prop/statement/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>

SELECT  ?year ?pope1Label ?pope2Label ?pope3Label
WHERE
  { ?pope2  p:P39     _:b0 .
    _:b0    ps:P39    wd:Q19546 ;
            pq:P580   ?p2s ;
            pq:P582   ?p2e ;
            pq:P1365  ?pope1 ;
            pq:P1366  ?pope3 .
    ?pope1  p:P39     _:b1 .
    _:b1    ps:P39    wd:Q19546 ;
            pq:P582   ?p1e .
    ?pope3  p:P39     _:b2 .
    _:b2    ps:P39    wd:Q19546 ;
            pq:P580   ?p3s
    BIND(year(?p2s) AS ?year)
    FILTER ( ( ( year(?p2e) = ?year ) && ( year(?p1e) = ?year ) ) && ( year(?p3s) = ?year ) )
    OPTIONAL
      { ?pope1  rdfs:label  ?pope1__label_value
        FILTER ( lang(?pope1__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?pope1  rdfs:label  ?pope1__label_value
        FILTER ( lang(?pope1__label_value) = "mul" )
      }
    OPTIONAL
      { ?pope1  rdfs:label  ?pope1__label_value
        FILTER ( lang(?pope1__label_value) = "en" )
      }
    BIND(if(bound(?pope1__label_value), ?pope1__label_value, if(( isURI(?pope1) && strstarts(str(?pope1), "http://www.wikidata.org/entity/") ), strafter(str(?pope1), "entity/"), str(?pope1))) AS ?pope1Label)
    OPTIONAL
      { ?pope2  rdfs:label  ?pope2__label_value
        FILTER ( lang(?pope2__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?pope2  rdfs:label  ?pope2__label_value
        FILTER ( lang(?pope2__label_value) = "mul" )
      }
    OPTIONAL
      { ?pope2  rdfs:label  ?pope2__label_value
        FILTER ( lang(?pope2__label_value) = "en" )
      }
    BIND(if(bound(?pope2__label_value), ?pope2__label_value, if(( isURI(?pope2) && strstarts(str(?pope2), "http://www.wikidata.org/entity/") ), strafter(str(?pope2), "entity/"), str(?pope2))) AS ?pope2Label)
    OPTIONAL
      { ?pope3  rdfs:label  ?pope3__label_value
        FILTER ( lang(?pope3__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?pope3  rdfs:label  ?pope3__label_value
        FILTER ( lang(?pope3__label_value) = "mul" )
      }
    OPTIONAL
      { ?pope3  rdfs:label  ?pope3__label_value
        FILTER ( lang(?pope3__label_value) = "en" )
      }
    BIND(if(bound(?pope3__label_value), ?pope3__label_value, if(( isURI(?pope3) && strstarts(str(?pope3), "http://www.wikidata.org/entity/") ), strafter(str(?pope3), "entity/"), str(?pope3))) AS ?pope3Label)
  }
ORDER BY ?year

