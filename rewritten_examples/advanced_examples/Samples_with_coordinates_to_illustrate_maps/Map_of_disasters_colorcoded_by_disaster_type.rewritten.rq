# rewrite_status: rewritten
#defaultView:Map{"layer":"?typeLabel"}
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?item ?itemLabel ?geo ?type ?typeLabel (SAMPLE(?_image) AS ?image)
WHERE
  { ?type (wdt:P279)* wd:Q3839081 .
    ?item  wdt:P31   ?type ;
           wdt:P625  ?geo
    OPTIONAL
      { ?item  wdt:P18  ?_image }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "en" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    BIND(if(bound(?item__label_value), ?item__label_value, if(( isURI(?item) && strstarts(str(?item), "http://www.wikidata.org/entity/") ), strafter(str(?item), "entity/"), str(?item))) AS ?itemLabel)
    OPTIONAL
      { ?type  rdfs:label  ?type__label_value
        FILTER ( lang(?type__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?type  rdfs:label  ?type__label_value
        FILTER ( lang(?type__label_value) = "en" )
      }
    OPTIONAL
      { ?type  rdfs:label  ?type__label_value
        FILTER ( lang(?type__label_value) = "mul" )
      }
    BIND(if(bound(?type__label_value), ?type__label_value, if(( isURI(?type) && strstarts(str(?type), "http://www.wikidata.org/entity/") ), strafter(str(?type), "entity/"), str(?type))) AS ?typeLabel)
  }
GROUP BY ?item ?itemLabel ?geo ?type ?typeLabel

