# rewrite_status: rewritten
#title: Brightest stars, with image
#defaultView:ImageGrid
# Brightest celestial bodies
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?star ?starLabel ?images ?apparent_magnitude
WHERE
  { { SELECT  ?star ?apparent_magnitude ?images
      WHERE
        { ?star  wdt:P31    wd:Q523 ;
                 wdt:P1215  ?apparent_magnitude ;
                 wdt:P18    ?images
          FILTER ( ?apparent_magnitude < 1 )
        }
      LIMIT   10
    }
    BIND(if(bound(?star), ?star, "unbound") AS ?star__label_subject)
    OPTIONAL
      { ?star__label_subject
                  rdfs:label  ?star__label_value
        FILTER ( lang(?star__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?star__label_subject
                  rdfs:label  ?star__label_value
        FILTER ( lang(?star__label_value) = "mul" )
      }
    OPTIONAL
      { ?star__label_subject
                  rdfs:label  ?star__label_value
        FILTER ( lang(?star__label_value) = "en" )
      }
    BIND(if(bound(?star__label_value), ?star__label_value, if(( isURI(?star) && strstarts(str(?star), "http://www.wikidata.org/entity/") ), strafter(str(?star), "entity/"), str(?star))) AS ?starLabel)
  }
ORDER BY ?apparent_magnitude

