# rewrite_status: rewritten
#title: Winners of the 2024 Summer Olympics
PREFIX  p:    <http://www.wikidata.org/prop/>
PREFIX  pq:   <http://www.wikidata.org/prop/qualifier/>
PREFIX  ps:   <http://www.wikidata.org/prop/statement/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT DISTINCT  ?eventLabel ?goldCountryLabel ?silverCountryLabel ?bronzeCountryLabel
WHERE
  { ?event  wdt:P31  wd:Q18536594 .
    ?event (wdt:P361)+ wd:Q995653 .
    ?event p:P710|p:P1923 _:b0 .
    _:b0 ps:P710|ps:P1923 ?gold .
    _:b0  pq:P166  wd:Q15243387 .
    ?event p:P710|p:P1923 _:b1 .
    _:b1 ps:P710|ps:P1923 ?silver .
    _:b1  pq:P166  wd:Q15889641 .
    ?event p:P710|p:P1923 _:b2 .
    _:b2 ps:P710|ps:P1923 ?bronze .
    _:b2     pq:P166    wd:Q15889643 .
    ?gold    wdt:P1532  ?goldCountry .
    ?silver  wdt:P1532  ?silverCountry .
    ?bronze  wdt:P1532  ?bronzeCountry
    OPTIONAL
      { ?event  rdfs:label  ?event__label_value
        FILTER ( lang(?event__label_value) = "en" )
      }
    OPTIONAL
      { ?event  rdfs:label  ?event__label_value
        FILTER ( lang(?event__label_value) = "mul" )
      }
    BIND(if(bound(?event__label_value), ?event__label_value, if(( isURI(?event) && strstarts(str(?event), "http://www.wikidata.org/entity/") ), strafter(str(?event), "entity/"), str(?event))) AS ?eventLabel)
    OPTIONAL
      { ?goldCountry  rdfs:label  ?goldCountry__label_value
        FILTER ( lang(?goldCountry__label_value) = "en" )
      }
    OPTIONAL
      { ?goldCountry  rdfs:label  ?goldCountry__label_value
        FILTER ( lang(?goldCountry__label_value) = "mul" )
      }
    BIND(if(bound(?goldCountry__label_value), ?goldCountry__label_value, if(( isURI(?goldCountry) && strstarts(str(?goldCountry), "http://www.wikidata.org/entity/") ), strafter(str(?goldCountry), "entity/"), str(?goldCountry))) AS ?goldCountryLabel)
    OPTIONAL
      { ?silverCountry
                  rdfs:label  ?silverCountry__label_value
        FILTER ( lang(?silverCountry__label_value) = "en" )
      }
    OPTIONAL
      { ?silverCountry
                  rdfs:label  ?silverCountry__label_value
        FILTER ( lang(?silverCountry__label_value) = "mul" )
      }
    BIND(if(bound(?silverCountry__label_value), ?silverCountry__label_value, if(( isURI(?silverCountry) && strstarts(str(?silverCountry), "http://www.wikidata.org/entity/") ), strafter(str(?silverCountry), "entity/"), str(?silverCountry))) AS ?silverCountryLabel)
    OPTIONAL
      { ?bronzeCountry
                  rdfs:label  ?bronzeCountry__label_value
        FILTER ( lang(?bronzeCountry__label_value) = "en" )
      }
    OPTIONAL
      { ?bronzeCountry
                  rdfs:label  ?bronzeCountry__label_value
        FILTER ( lang(?bronzeCountry__label_value) = "mul" )
      }
    BIND(if(bound(?bronzeCountry__label_value), ?bronzeCountry__label_value, if(( isURI(?bronzeCountry) && strstarts(str(?bronzeCountry), "http://www.wikidata.org/entity/") ), strafter(str(?bronzeCountry), "entity/"), str(?bronzeCountry))) AS ?bronzeCountryLabel)
  }
ORDER BY ?eventLabel

# Original query:
# #title: Winners of the 2024 Summer Olympics
# SELECT DISTINCT ?eventLabel ?goldCountryLabel ?silverCountryLabel ?bronzeCountryLabel WHERE {
#   ?event wdt:P31 wd:Q18536594; # individual event
#          wdt:P361+ wd:Q995653; # part of 2024 summer olympics
#          (p:P710|p:P1923) [ (ps:P710|ps:P1923) ?gold;
#                             pq:P166 wd:Q15243387 ]; # award: gold medal
#          (p:P710|p:P1923) [ (ps:P710|ps:P1923) ?silver;
#                             pq:P166 wd:Q15889641 ]; # award: silver medal
#          (p:P710|p:P1923) [ (ps:P710|ps:P1923) ?bronze;
#                             pq:P166 wd:Q15889643 ]. # award: bronze medal
#   # fetch the country of the winner
#   ?gold wdt:P1532 ?goldCountry.
#   ?silver wdt:P1532 ?silverCountry.
#   ?bronze wdt:P1532 ?bronzeCountry.
#   SERVICE wikibase:label { bd:serviceParam wikibase:language "en,mul". }
# } ORDER BY ?eventLabel
