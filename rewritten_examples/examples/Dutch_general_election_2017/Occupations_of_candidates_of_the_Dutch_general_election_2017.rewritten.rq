# rewrite_status: rewritten
#title: Occupations of candidates of the Dutch general election 2017
# Kandidaten voor de Nederlandse TK verkiezingen van 2017
#defaultView:Dimensions
PREFIX  p:    <http://www.wikidata.org/prop/>
PREFIX  pq:   <http://www.wikidata.org/prop/qualifier/>
PREFIX  ps:   <http://www.wikidata.org/prop/statement/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?positie_op_lijst ?genderLabel ?occupationLabel ?politieke_partijLabel
WHERE
  { VALUES ?politieke_partij { wd:Q747910 wd:Q275441 }
    ?item  p:P3602    ?node ;
           wdt:P21    ?gender ;
           wdt:P106   ?occupation .
    ?node  ps:P3602   wd:Q16061881 ;
           pq:P10777  ?positie_op_lijst ;
           pq:P1268   ?politieke_partij
    OPTIONAL
      { ?gender  rdfs:label  ?gender__label_value
        FILTER ( lang(?gender__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?gender  rdfs:label  ?gender__label_value
        FILTER ( lang(?gender__label_value) = "nl" )
      }
    OPTIONAL
      { ?gender  rdfs:label  ?gender__label_value
        FILTER ( lang(?gender__label_value) = "mul" )
      }
    BIND(if(bound(?gender__label_value), ?gender__label_value, if(( isURI(?gender) && strstarts(str(?gender), "http://www.wikidata.org/entity/") ), strafter(str(?gender), "entity/"), str(?gender))) AS ?genderLabel)
    OPTIONAL
      { ?occupation  rdfs:label  ?occupation__label_value
        FILTER ( lang(?occupation__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?occupation  rdfs:label  ?occupation__label_value
        FILTER ( lang(?occupation__label_value) = "nl" )
      }
    OPTIONAL
      { ?occupation  rdfs:label  ?occupation__label_value
        FILTER ( lang(?occupation__label_value) = "mul" )
      }
    BIND(if(bound(?occupation__label_value), ?occupation__label_value, if(( isURI(?occupation) && strstarts(str(?occupation), "http://www.wikidata.org/entity/") ), strafter(str(?occupation), "entity/"), str(?occupation))) AS ?occupationLabel)
    OPTIONAL
      { ?politieke_partij
                  rdfs:label  ?politieke_partij__label_value
        FILTER ( lang(?politieke_partij__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?politieke_partij
                  rdfs:label  ?politieke_partij__label_value
        FILTER ( lang(?politieke_partij__label_value) = "nl" )
      }
    OPTIONAL
      { ?politieke_partij
                  rdfs:label  ?politieke_partij__label_value
        FILTER ( lang(?politieke_partij__label_value) = "mul" )
      }
    BIND(if(bound(?politieke_partij__label_value), ?politieke_partij__label_value, if(( isURI(?politieke_partij) && strstarts(str(?politieke_partij), "http://www.wikidata.org/entity/") ), strafter(str(?politieke_partij), "entity/"), str(?politieke_partij))) AS ?politieke_partijLabel)
  }

