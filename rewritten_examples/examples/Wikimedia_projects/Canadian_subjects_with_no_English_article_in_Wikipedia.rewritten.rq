# rewrite_status: rewritten
#title: Canadian subjects with no English article in Wikipedia
# --
# added before 2019-02
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  schema: <http://schema.org/>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?item ?itemLabel ?cnt
WHERE
  { { SELECT  ?item (COUNT(?sitelink) AS ?cnt)
      WHERE
        { ?item (wdt:P27|wdt:P205)|wdt:P17 wd:Q16
          MINUS
            { ?item  wdt:P106  wd:Q488111 }
          MINUS
            { ?item  wdt:P106  wd:Q3286043 }
          MINUS
            { ?item  wdt:P106  wd:Q4610556 }
          ?sitelink  schema:about  ?item
          FILTER NOT EXISTS { ?article  schema:about     ?item ;
                                        schema:isPartOf  <https://en.wikipedia.org/>
                            }
        }
      GROUP BY ?item
      ORDER BY DESC(?cnt)
      LIMIT   500
    }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "en" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "fr" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "es" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "de" )
      }
    BIND(if(bound(?item__label_value), ?item__label_value, if(( isURI(?item) && strstarts(str(?item), "http://www.wikidata.org/entity/") ), strafter(str(?item), "entity/"), str(?item))) AS ?itemLabel)
  }
ORDER BY DESC(?cnt)

# Original query:
