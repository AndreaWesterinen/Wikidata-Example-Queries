# rewrite_status: rewritten
#title: Streets in France named after a woman
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?street ?streetLabel ?cityLabel ?namedLabel
WHERE
  { ?street  wdt:P31   wd:Q79007 ;
             wdt:P17   wd:Q142 ;
             wdt:P131  ?city ;
             wdt:P138  ?named .
    ?named   wdt:P21   wd:Q6581072
    OPTIONAL
      { ?street  rdfs:label  ?street__label_value
        FILTER ( lang(?street__label_value) = "fr" )
      }
    OPTIONAL
      { ?street  rdfs:label  ?street__label_value
        FILTER ( lang(?street__label_value) = "mul" )
      }
    BIND(if(bound(?street__label_value), ?street__label_value, if(( isURI(?street) && strstarts(str(?street), "http://www.wikidata.org/entity/") ), strafter(str(?street), "entity/"), str(?street))) AS ?streetLabel)
    OPTIONAL
      { ?city  rdfs:label  ?city__label_value
        FILTER ( lang(?city__label_value) = "fr" )
      }
    OPTIONAL
      { ?city  rdfs:label  ?city__label_value
        FILTER ( lang(?city__label_value) = "mul" )
      }
    BIND(if(bound(?city__label_value), ?city__label_value, if(( isURI(?city) && strstarts(str(?city), "http://www.wikidata.org/entity/") ), strafter(str(?city), "entity/"), str(?city))) AS ?cityLabel)
    OPTIONAL
      { ?named  rdfs:label  ?named__label_value
        FILTER ( lang(?named__label_value) = "fr" )
      }
    OPTIONAL
      { ?named  rdfs:label  ?named__label_value
        FILTER ( lang(?named__label_value) = "mul" )
      }
    BIND(if(bound(?named__label_value), ?named__label_value, if(( isURI(?named) && strstarts(str(?named), "http://www.wikidata.org/entity/") ), strafter(str(?named), "entity/"), str(?named))) AS ?namedLabel)
  }
ORDER BY ?city

