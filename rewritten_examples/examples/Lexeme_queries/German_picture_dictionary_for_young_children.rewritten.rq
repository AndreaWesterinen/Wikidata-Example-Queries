# rewrite_status: rewritten
#title: German picture dictionary for young children
# German picture dictionary for young children
# NB: when 2 or more pictures occur for the same lemma a preferred rank is missing on the Q-item.
# Please fix that if you know how.
# If any inapproriate terms show up it is probably because the sense is missing a correct P5137
# by So9q
#defaultView:ImageGrid
PREFIX  dct:  <http://purl.org/dc/terms/>
PREFIX  ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX  schema: <http://schema.org/>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX  wikibase: <http://wikiba.se/ontology#>

SELECT DISTINCT  ?lexemeId ?lemma ?q_concept ?q_conceptDescription ?picture
WHERE
  { ?lexemeId  dct:language   wd:Q188 ;
              wikibase:lemma  ?lemma ;
              ontolex:sense   ?sense .
    ?sense    wdt:P5137       ?q_concept .
    ?q_concept  wdt:P18       ?picture
    MINUS
      { ?q_concept  wdt:P31  wd:Q3624078 }
    VALUES ?minus { wd:Q47092 wd:Q198 wd:Q124490 wd:Q170382 wd:Q1576 }
    MINUS
      { ?sense  wdt:P5137  ?minus }
    VALUES ?filter { wd:Q8102 wd:Q545779 wd:Q1521634 wd:Q184439 }
    FILTER NOT EXISTS { ?sense  wdt:P6191  ?filter }
    OPTIONAL
      { ?q_concept  schema:description  ?q_concept__description_value
        FILTER ( lang(?q_concept__description_value) = "de" )
      }
    OPTIONAL
      { ?q_concept  schema:description  ?q_concept__description_value
        FILTER ( lang(?q_concept__description_value) = "en" )
      }
    BIND(?q_concept__description_value AS ?q_conceptDescription)
  }
ORDER BY lcase(?lemma)

