#    ?statement prov:wasDerivedFrom ?ref .
#    ?ref pr:P356 ?doi .
#    FILTER (CONTAINS(lcase(?doi), "figshare"))
#   SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],mul,en". }
