# rewrite_status: rewritten
PREFIX  p:    <http://www.wikidata.org/prop/>
PREFIX  pq:   <http://www.wikidata.org/prop/qualifier/>
PREFIX  ps:   <http://www.wikidata.org/prop/statement/>
PREFIX  psv:  <http://www.wikidata.org/prop/statement/value/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  schema: <http://schema.org/>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX  wikibase: <http://wikiba.se/ontology#>
PREFIX  xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT  ?monthLabel (?day_int AS ?d) ?personLabel ?personDesc (URI(concat("https://tools.wmflabs.org/reasonator/?q=", substr(str(?rperson), 32))) AS ?link)
WHERE
  { { SELECT  ?month_int ?month ?day_int (SAMPLE(?person) AS ?rperson)
      WHERE
        { ?month  wdt:P31    wd:Q47018901 ;
                  wdt:P1545  ?month_ordinal .
          ?day    p:P361     _:b0 .
          _:b0    ps:P361    ?month ;
                  pq:P1545   ?day_ordinal
          BIND(xsd:integer(?month_ordinal) AS ?month_int)
          BIND(xsd:integer(?day_ordinal) AS ?day_int)
          OPTIONAL
            {   { ?person  wdt:P69  wd:Q34433 }
              UNION
                { ?person wdt:P69/wdt:P31 wd:Q2581649 }
              ?person  wdt:P21  wd:Q6581072 .
              ?person p:P569/psv:P569 ?date_node .
              ?date_node  wikibase:timePrecision  11 ;
                        wikibase:timeValue    ?birthdate
              FILTER ( day(?birthdate) = ?day_int )
              FILTER ( month(?birthdate) = ?month_int )
            }
        }
      GROUP BY ?month_int ?month ?day_int
    }
    BIND(if(bound(?rperson), ?rperson, "unbound") AS ?rperson__label_subject)
    OPTIONAL
      { ?rperson__label_subject
                  rdfs:label  ?rperson__label_value
        FILTER ( lang(?rperson__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?rperson__label_subject
                  rdfs:label  ?rperson__label_value
        FILTER ( lang(?rperson__label_value) = "en" )
      }
    OPTIONAL
      { ?rperson__label_subject
                  rdfs:label  ?rperson__label_value
        FILTER ( lang(?rperson__label_value) = "mul" )
      }
    BIND(if(bound(?rperson__label_value), ?rperson__label_value, if(( isURI(?rperson) && strstarts(str(?rperson), "http://www.wikidata.org/entity/") ), strafter(str(?rperson), "entity/"), str(?rperson))) AS ?personLabel)
    BIND(if(bound(?rperson), ?rperson, "unbound") AS ?rperson__label_subject__1)
    OPTIONAL
      { ?rperson__label_subject__1
                  schema:description  ?rperson__description_value
        FILTER ( lang(?rperson__description_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?rperson__label_subject__1
                  schema:description  ?rperson__description_value
        FILTER ( lang(?rperson__description_value) = "en" )
      }
    BIND(?rperson__description_value AS ?personDesc)
    OPTIONAL
      { ?month  rdfs:label  ?month__label_value
        FILTER ( lang(?month__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?month  rdfs:label  ?month__label_value
        FILTER ( lang(?month__label_value) = "en" )
      }
    OPTIONAL
      { ?month  rdfs:label  ?month__label_value
        FILTER ( lang(?month__label_value) = "mul" )
      }
    BIND(if(bound(?month__label_value), ?month__label_value, if(( isURI(?month) && strstarts(str(?month), "http://www.wikidata.org/entity/") ), strafter(str(?month), "entity/"), str(?month))) AS ?monthLabel)
  }
ORDER BY ?month_int ?day_int

