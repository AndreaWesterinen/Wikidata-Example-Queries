#       bd:serviceParam wikibase:center ?loc .
#       bd:serviceParam wikibase:radius "1" .
#   }
#   OPTIONAL { ?place wdt:P31 ?instance }
#   SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
#   BIND(geof:distance(?loc, ?location) as ?dist)
