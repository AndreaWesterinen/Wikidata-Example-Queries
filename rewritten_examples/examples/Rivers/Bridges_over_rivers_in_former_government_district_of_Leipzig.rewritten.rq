# rewrite_status: rewritten
#title: Bridges over rivers in former government district of Leipzig
#defaultView:Map{"layer":"?wcourseLabel"}
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  schema: <http://schema.org/>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?br ?brLabel ?wcourse ?wcourseLabel (SAMPLE(?coord) AS ?loc) (SAMPLE(?img) AS ?pic) (concat(SAMPLE(?sKey), ": ", str(year(SAMPLE(?s)))) AS ?start) (concat(SAMPLE(?eKey), ": ", str(year(SAMPLE(?e)))) AS ?end) ?a (if(bound(?a), concat(?brLabel, " in Wikipedia"), ( 1 / 0 )) AS ?aLabel)
WHERE
  {   { VALUES ?lk { wd:Q6301 wd:Q6308 wd:Q20233 }
        ?lk  wdt:P150  ?mun
      }
    UNION
      { VALUES ?mun { wd:Q2079 wd:Q113503289 } }
    ?br wdt:P31/(wdt:P279)* wd:Q12280 .
    ?br  wdt:P177  ?wcourse ;
         wdt:P131  ?mun .
    ?wcourse wdt:P31/(wdt:P279)* wd:Q355304
    OPTIONAL
      { ?br  wdt:P625  ?coord }
    OPTIONAL
      { ?br  wdt:P18  ?img }
    OPTIONAL
      { ?br  wdt:P571  ?s }
    OPTIONAL
      { ?br  wdt:P576  ?e }
    OPTIONAL
      { ?a  schema:about  ?br
        FILTER if(EXISTS { ?a  schema:inLanguage  "[AUTO_LANGUAGE]" }, ( substr(str(?a), 1, 11) = substr("https://[AUTO_LANGUAGE].", 1, 11) ), if(EXISTS { ?a  schema:inLanguage  "en" }, ( substr(str(?a), 1, 10) = "https://en" ), ( substr(str(?a), 1, 10) = "https://de" )))
      }
    OPTIONAL
      { ?br  rdfs:label  ?br__label_value
        FILTER ( lang(?br__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?br  rdfs:label  ?br__label_value
        FILTER ( lang(?br__label_value) = "mul" )
      }
    OPTIONAL
      { ?br  rdfs:label  ?br__label_value
        FILTER ( lang(?br__label_value) = "en" )
      }
    OPTIONAL
      { ?br  rdfs:label  ?br__label_value
        FILTER ( lang(?br__label_value) = "de" )
      }
    BIND(if(bound(?br__label_value), ?br__label_value, if(( isURI(?br) && strstarts(str(?br), "http://www.wikidata.org/entity/") ), strafter(str(?br), "entity/"), str(?br))) AS ?brLabel)
    OPTIONAL
      { ?wcourse  rdfs:label  ?wcourse__label_value
        FILTER ( lang(?wcourse__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?wcourse  rdfs:label  ?wcourse__label_value
        FILTER ( lang(?wcourse__label_value) = "mul" )
      }
    OPTIONAL
      { ?wcourse  rdfs:label  ?wcourse__label_value
        FILTER ( lang(?wcourse__label_value) = "en" )
      }
    OPTIONAL
      { ?wcourse  rdfs:label  ?wcourse__label_value
        FILTER ( lang(?wcourse__label_value) = "de" )
      }
    BIND(if(bound(?wcourse__label_value), ?wcourse__label_value, if(( isURI(?wcourse) && strstarts(str(?wcourse), "http://www.wikidata.org/entity/") ), strafter(str(?wcourse), "entity/"), str(?wcourse))) AS ?wcourseLabel)
    OPTIONAL
      { wd:P571  rdfs:label  ?sKey__label_value
        FILTER ( lang(?sKey__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { wd:P571  rdfs:label  ?sKey__label_value
        FILTER ( lang(?sKey__label_value) = "mul" )
      }
    OPTIONAL
      { wd:P571  rdfs:label  ?sKey__label_value
        FILTER ( lang(?sKey__label_value) = "en" )
      }
    OPTIONAL
      { wd:P571  rdfs:label  ?sKey__label_value
        FILTER ( lang(?sKey__label_value) = "de" )
      }
    BIND(if(bound(?sKey__label_value), ?sKey__label_value, strafter(str(wd:P571), "entity/")) AS ?sKey)
    OPTIONAL
      { wd:P576  rdfs:label  ?eKey__label_value
        FILTER ( lang(?eKey__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { wd:P576  rdfs:label  ?eKey__label_value
        FILTER ( lang(?eKey__label_value) = "mul" )
      }
    OPTIONAL
      { wd:P576  rdfs:label  ?eKey__label_value
        FILTER ( lang(?eKey__label_value) = "en" )
      }
    OPTIONAL
      { wd:P576  rdfs:label  ?eKey__label_value
        FILTER ( lang(?eKey__label_value) = "de" )
      }
    BIND(if(bound(?eKey__label_value), ?eKey__label_value, strafter(str(wd:P576), "entity/")) AS ?eKey)
  }
GROUP BY ?br ?brLabel ?wcourse ?wcourseLabel ?a

