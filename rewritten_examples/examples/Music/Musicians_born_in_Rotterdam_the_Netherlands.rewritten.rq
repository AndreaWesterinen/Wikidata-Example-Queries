# rewrite_status: rewritten
#title: Musicians born in Rotterdam (the Netherlands)
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  schema: <http://schema.org/>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT DISTINCT  ?item ?itemLabel ?itemDescription
WHERE
  { ?item wdt:P106/(wdt:P279)* wd:Q639669 .
    ?item wdt:P19/(wdt:P131)* wd:Q34370
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "en" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "nl" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    BIND(if(bound(?item__label_value), ?item__label_value, if(( isURI(?item) && strstarts(str(?item), "http://www.wikidata.org/entity/") ), strafter(str(?item), "entity/"), str(?item))) AS ?itemLabel)
    OPTIONAL
      { ?item  schema:description  ?item__description_value
        FILTER ( lang(?item__description_value) = "en" )
      }
    OPTIONAL
      { ?item  schema:description  ?item__description_value
        FILTER ( lang(?item__description_value) = "nl" )
      }
    BIND(?item__description_value AS ?itemDescription)
  }

# Original query:
# #title: Musicians born in Rotterdam (the Netherlands)
# SELECT DISTINCT ?item ?itemLabel ?itemDescription where {
#     ?item wdt:P106/wdt:P279* wd:Q639669 .
#     ?item wdt:P19/wdt:P131* wd:Q34370 .
#     SERVICE wikibase:label { bd:serviceParam wikibase:language "en,nl" }
# }
