# rewrite_status: rewritten
#title: Fictional characters whose birth/death date is in the current decade
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX  xsd:  <http://www.w3.org/2001/XMLSchema#>

WITH %i AS {
?fictiontype wdt:P279* wd:Q95074.
}
SELECT DISTINCT  ?character ?characterLabel ?birth ?death
WHERE
  { { SELECT ?fictiontype WHERE { INCLUDE %i } }?character  wdt:P31  ?fictiontype
      { ?character  wdt:P569  ?birth }
    UNION
      { ?character  wdt:P570  ?death }
    BIND(xsd:integer(( year(now()) / 10 )) AS ?actual_decade)
    FILTER ( ( xsd:integer(( year(?birth) / 10 )) = ?actual_decade ) || ( xsd:integer(( year(?death) / 10 )) = ?actual_decade ) )
    OPTIONAL
      { ?character  rdfs:label  ?character__label_value
        FILTER ( lang(?character__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?character  rdfs:label  ?character__label_value
        FILTER ( lang(?character__label_value) = "mul" )
      }
    OPTIONAL
      { ?character  rdfs:label  ?character__label_value
        FILTER ( lang(?character__label_value) = "en" )
      }
    BIND(if(bound(?character__label_value), ?character__label_value, if(( isURI(?character) && strstarts(str(?character), "http://www.wikidata.org/entity/") ), strafter(str(?character), "entity/"), str(?character))) AS ?characterLabel)
  }
ORDER BY ?birth ?death

