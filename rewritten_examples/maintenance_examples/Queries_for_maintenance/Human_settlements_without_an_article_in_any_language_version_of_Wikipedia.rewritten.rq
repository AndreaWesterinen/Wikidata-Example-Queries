#     ?city wdt:P31 wd:Q3957 ;
#           wdt:P625 ?coor .
#
#     FILTER NOT EXISTS {?article schema:about ?city } .
#     SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
# }
