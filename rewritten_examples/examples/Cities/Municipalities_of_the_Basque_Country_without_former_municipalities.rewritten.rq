# rewrite_status: rewritten
#title: Municipalities of the Basque Country without former municipalities
# This query has two different features:
# First, it is able to search for municipalities which are part of two different states, looking to P527
# Second, it doesn't show former municipalities, filtering the old ones from the P582 statement.
PREFIX  p:    <http://www.wikidata.org/prop/>
PREFIX  pq:   <http://www.wikidata.org/prop/qualifier/>
PREFIX  ps:   <http://www.wikidata.org/prop/statement/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT DISTINCT  ?udalerri ?udalerriLabel
WHERE
  { ?udalerri  p:P31  ?status .
    ?udalerri (wdt:P131)*/^wdt:P527 wd:Q47588
      { ?status  ps:P31  wd:Q484170 }
    UNION
      { ?status  ps:P31  wd:Q2074737 }
    MINUS
      { ?status  pq:P582  ?old }
    OPTIONAL
      { ?udalerri  rdfs:label  ?udalerri__label_value
        FILTER ( lang(?udalerri__label_value) = "eu" )
      }
    OPTIONAL
      { ?udalerri  rdfs:label  ?udalerri__label_value
        FILTER ( lang(?udalerri__label_value) = "es" )
      }
    OPTIONAL
      { ?udalerri  rdfs:label  ?udalerri__label_value
        FILTER ( lang(?udalerri__label_value) = "fr" )
      }
    OPTIONAL
      { ?udalerri  rdfs:label  ?udalerri__label_value
        FILTER ( lang(?udalerri__label_value) = "en" )
      }
    OPTIONAL
      { ?udalerri  rdfs:label  ?udalerri__label_value
        FILTER ( lang(?udalerri__label_value) = "mul" )
      }
    BIND(if(bound(?udalerri__label_value), ?udalerri__label_value, if(( isURI(?udalerri) && strstarts(str(?udalerri), "http://www.wikidata.org/entity/") ), strafter(str(?udalerri), "entity/"), str(?udalerri))) AS ?udalerriLabel)
  }

# Original query:
# #title: Municipalities of the Basque Country without former municipalities
# # This query has two different features:
# # First, it is able to search for municipalities which are part of two different states, looking to P527
# # Second, it doesn't show former municipalities, filtering the old ones from the P582 statement.
# SELECT DISTINCT ?udalerri ?udalerriLabel WHERE { 
#   ?udalerri p:P31 ?status.
#   ?udalerri wdt:P131*/^wdt:P527 wd:Q47588 .
#   {?status ps:P31 wd:Q484170.} UNION {?status ps:P31 wd:Q2074737}
#   MINUS {?status pq:P582 ?old .}
#   SERVICE wikibase:label { bd:serviceParam wikibase:language "eu,es,fr,en". }
# }
