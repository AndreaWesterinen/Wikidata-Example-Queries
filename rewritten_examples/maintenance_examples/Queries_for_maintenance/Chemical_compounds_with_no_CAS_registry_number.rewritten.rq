# rewrite_status: rewritten
#added before 2016-10

#All CAS registry numbers in Wikidata
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT DISTINCT  ?compound ?compoundLabel ?formula ?inchikey ?chemspider ?pubchem
WHERE
  { ?compound  wdt:P31  wd:Q11173
    OPTIONAL
      { ?compound  wdt:P231  ?cas }
    OPTIONAL
      { ?compound  wdt:P274  ?formula }
    OPTIONAL
      { ?compound  wdt:P235  ?inchikey }
    OPTIONAL
      { ?compound  wdt:P661  ?chemspider }
    OPTIONAL
      { ?compound  wdt:P662  ?pubchem }
    OPTIONAL
      { ?compound  rdfs:label  ?compound__label_value
        FILTER ( lang(?compound__label_value) = "en" )
      }
    OPTIONAL
      { ?compound  rdfs:label  ?compound__label_value
        FILTER ( lang(?compound__label_value) = "mul" )
      }
    BIND(if(bound(?compound__label_value), ?compound__label_value, if(( isURI(?compound) && strstarts(str(?compound), "http://www.wikidata.org/entity/") ), strafter(str(?compound), "entity/"), str(?compound))) AS ?compoundLabel)
    FILTER ( ! bound(?cas) )
  }

