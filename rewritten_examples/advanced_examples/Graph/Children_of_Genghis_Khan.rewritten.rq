# rewrite_status: rewritten
#defaultView:Graph
PREFIX  pathSearch: <https://qlever.cs.uni-freiburg.de/pathSearch/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?item ?itemLabel ?pic ?linkTo
WHERE
  { { SELECT  ?item (MIN(?d) AS ?depth)
      WHERE
        { {   { BIND(wd:Q720 AS ?item)
                BIND(0 AS ?d)
              }
            UNION
              { SERVICE pathSearch:
                  { _:b0  pathSearch:algorithm  pathSearch:allPaths ;
                          pathSearch:source     wd:Q720 ;
                          pathSearch:maxDepth   4 ;
                          pathSearch:start      ?predecessor ;
                          pathSearch:end        ?item ;
                          pathSearch:pathColumn  ?pc ;
                          pathSearch:edgeColumn  ?edge
                    { SELECT  *
                      WHERE
                        { ?predecessor  wdt:P40  ?item }
                    }
                  }
                BIND(( ?edge + 1 ) AS ?d)
              }
          }
        }
      GROUP BY ?item
    }
    OPTIONAL
      { ?item  wdt:P40  ?linkTo }
    OPTIONAL
      { ?item  wdt:P18  ?pic }
    BIND(if(bound(?item), ?item, "unbound") AS ?item__label_subject)
    OPTIONAL
      { ?item__label_subject
                  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?item__label_subject
                  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "en" )
      }
    OPTIONAL
      { ?item__label_subject
                  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    BIND(if(bound(?item__label_value), ?item__label_value, if(( isURI(?item) && strstarts(str(?item), "http://www.wikidata.org/entity/") ), strafter(str(?item), "entity/"), str(?item))) AS ?itemLabel)
  }

