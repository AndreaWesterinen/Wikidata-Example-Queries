# rewrite_status: rewritten
#title: Galaxies ordered by the ones that are most linked from scientific articles
#author: So9q, 2021-10-27
#note: I deliberately choose a smaller subgraph (galaxies) to prevent a timeout on WDQS
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?main_subject ?main_subjectLabel (COUNT(?item) AS ?c)
WHERE
  { ?item  wdt:P31   wd:Q13442814 ;
           wdt:P921  ?main_subject .
    ?main_subject wdt:P31/(wdt:P279)* wd:Q318
    OPTIONAL
      { ?main_subject
                  rdfs:label  ?main_subject__label_value
        FILTER ( lang(?main_subject__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?main_subject
                  rdfs:label  ?main_subject__label_value
        FILTER ( lang(?main_subject__label_value) = "mul" )
      }
    OPTIONAL
      { ?main_subject
                  rdfs:label  ?main_subject__label_value
        FILTER ( lang(?main_subject__label_value) = "en" )
      }
    BIND(if(bound(?main_subject__label_value), ?main_subject__label_value, if(( isURI(?main_subject) && strstarts(str(?main_subject), "http://www.wikidata.org/entity/") ), strafter(str(?main_subject), "entity/"), str(?main_subject))) AS ?main_subjectLabel)
  }
GROUP BY ?main_subject ?main_subjectLabel
ORDER BY DESC(?c)

