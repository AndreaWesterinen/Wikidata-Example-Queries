# rewrite_status: rewritten
#title: Sculptures by Max Bill
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT DISTINCT  ?item ?itemLabel ?countryLabel ?placeLabel (year(?date) AS ?year) ?coords ?image
WHERE
  { ?item wdt:P31/(wdt:P279)* wd:Q860861 .
    ?item  wdt:P170  wd:Q123454
    OPTIONAL
      { ?item  wdt:P17  ?country }
    OPTIONAL
      { ?item  wdt:P131  ?place }
    OPTIONAL
      { ?item  wdt:P571  ?date }
    OPTIONAL
      { ?item  wdt:P625  ?coords }
    OPTIONAL
      { ?item  wdt:P18  ?image }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "en" )
      }
    BIND(if(bound(?item__label_value), ?item__label_value, if(( isURI(?item) && strstarts(str(?item), "http://www.wikidata.org/entity/") ), strafter(str(?item), "entity/"), str(?item))) AS ?itemLabel)
    BIND(if(bound(?country), ?country, "unbound") AS ?country__label_subject)
    OPTIONAL
      { ?country__label_subject
                  rdfs:label  ?country__label_value
        FILTER ( lang(?country__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?country__label_subject
                  rdfs:label  ?country__label_value
        FILTER ( lang(?country__label_value) = "mul" )
      }
    OPTIONAL
      { ?country__label_subject
                  rdfs:label  ?country__label_value
        FILTER ( lang(?country__label_value) = "en" )
      }
    BIND(if(bound(?country__label_value), ?country__label_value, if(( isURI(?country) && strstarts(str(?country), "http://www.wikidata.org/entity/") ), strafter(str(?country), "entity/"), str(?country))) AS ?countryLabel)
    BIND(if(bound(?place), ?place, "unbound") AS ?place__label_subject)
    OPTIONAL
      { ?place__label_subject
                  rdfs:label  ?place__label_value
        FILTER ( lang(?place__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?place__label_subject
                  rdfs:label  ?place__label_value
        FILTER ( lang(?place__label_value) = "mul" )
      }
    OPTIONAL
      { ?place__label_subject
                  rdfs:label  ?place__label_value
        FILTER ( lang(?place__label_value) = "en" )
      }
    BIND(if(bound(?place__label_value), ?place__label_value, if(( isURI(?place) && strstarts(str(?place), "http://www.wikidata.org/entity/") ), strafter(str(?place), "entity/"), str(?place))) AS ?placeLabel)
  }
ORDER BY ?itemLabel ?placeLabel

