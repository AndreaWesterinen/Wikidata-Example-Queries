# WHERE {
# 	?item wdt:P86 wd:Q254 ; # composer: W. A. Mozart
#           wdt:P528 ?catalog_code ;
#           wdt:P577 ?publication_date .
# 	SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
# }
