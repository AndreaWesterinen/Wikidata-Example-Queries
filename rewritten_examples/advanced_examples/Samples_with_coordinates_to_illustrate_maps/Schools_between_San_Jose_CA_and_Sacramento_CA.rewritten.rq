#       ?place wdt:P625 ?location .
#       bd:serviceParam wikibase:cornerWest ?SJloc .
#       bd:serviceParam wikibase:cornerEast ?SCloc .
#     }
#   ?place wdt:P31/wdt:P279* wd:Q3914 .
# }
