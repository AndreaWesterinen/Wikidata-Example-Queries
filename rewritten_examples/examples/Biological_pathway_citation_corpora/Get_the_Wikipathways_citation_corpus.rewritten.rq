# rewrite_status: rewritten
#title: Get the Wikipathways citation corpus
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?wpid ?item ?itemLabel ?referenceLabel
WHERE
  { ?item  wdt:P2410  ?wpid ;
           wdt:P2860  ?reference
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "en" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    BIND(if(bound(?item__label_value), ?item__label_value, if(( isURI(?item) && strstarts(str(?item), "http://www.wikidata.org/entity/") ), strafter(str(?item), "entity/"), str(?item))) AS ?itemLabel)
    OPTIONAL
      { ?reference  rdfs:label  ?reference__label_value
        FILTER ( lang(?reference__label_value) = "en" )
      }
    OPTIONAL
      { ?reference  rdfs:label  ?reference__label_value
        FILTER ( lang(?reference__label_value) = "mul" )
      }
    BIND(if(bound(?reference__label_value), ?reference__label_value, if(( isURI(?reference) && strstarts(str(?reference), "http://www.wikidata.org/entity/") ), strafter(str(?reference), "entity/"), str(?reference))) AS ?referenceLabel)
  }

# Original query:
