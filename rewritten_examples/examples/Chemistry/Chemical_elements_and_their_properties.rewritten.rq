# rewrite_status: rewritten
#title: Chemical elements and their properties
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?elementLabel ?_boiling_point ?_melting_point ?_electronegativity ?_density ?_mass
WHERE
  { ?element  wdt:P31    wd:Q11344 ;
              wdt:P2102  ?_boiling_point ;
              wdt:P2101  ?_melting_point ;
              wdt:P1108  ?_electronegativity ;
              wdt:P2054  ?_density ;
              wdt:P2067  ?_mass
    OPTIONAL
      { ?element  rdfs:label  ?element__label_value
        FILTER ( lang(?element__label_value) = "en" )
      }
    OPTIONAL
      { ?element  rdfs:label  ?element__label_value
        FILTER ( lang(?element__label_value) = "mul" )
      }
    BIND(if(bound(?element__label_value), ?element__label_value, if(( isURI(?element) && strstarts(str(?element), "http://www.wikidata.org/entity/") ), strafter(str(?element), "entity/"), str(?element))) AS ?elementLabel)
  }
LIMIT   100

