# rewrite_status: rewritten
#title: Map of institutions where Canadian citizens got their PhD
#defaultView:Map
PREFIX  p:    <http://www.wikidata.org/prop/>
PREFIX  pq:   <http://www.wikidata.org/prop/qualifier/>
PREFIX  ps:   <http://www.wikidata.org/prop/statement/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT DISTINCT  ?institution ?institutionLabel ?academics ?academicsLabel ?degree ?degreeLabel ?geoloc ?image
WHERE
  { ?academics  wdt:P31  wd:Q5 ;
              wdt:P27  wd:Q16 ;
              p:P69    ?statement
    OPTIONAL
      { ?academics  wdt:P18  ?image }
    ?statement  ps:P69  ?institution .
    ?institution  wdt:P625  ?geoloc .
    ?statement  pq:P512  ?degree .
    ?degree wdt:P31/(wdt:P279)* wd:Q849697
    OPTIONAL
      { ?institution  rdfs:label  ?institution__label_value
        FILTER ( lang(?institution__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?institution  rdfs:label  ?institution__label_value
        FILTER ( lang(?institution__label_value) = "mul" )
      }
    OPTIONAL
      { ?institution  rdfs:label  ?institution__label_value
        FILTER ( lang(?institution__label_value) = "en" )
      }
    BIND(if(bound(?institution__label_value), ?institution__label_value, if(( isURI(?institution) && strstarts(str(?institution), "http://www.wikidata.org/entity/") ), strafter(str(?institution), "entity/"), str(?institution))) AS ?institutionLabel)
    OPTIONAL
      { ?academics  rdfs:label  ?academics__label_value
        FILTER ( lang(?academics__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?academics  rdfs:label  ?academics__label_value
        FILTER ( lang(?academics__label_value) = "mul" )
      }
    OPTIONAL
      { ?academics  rdfs:label  ?academics__label_value
        FILTER ( lang(?academics__label_value) = "en" )
      }
    BIND(if(bound(?academics__label_value), ?academics__label_value, if(( isURI(?academics) && strstarts(str(?academics), "http://www.wikidata.org/entity/") ), strafter(str(?academics), "entity/"), str(?academics))) AS ?academicsLabel)
    OPTIONAL
      { ?degree  rdfs:label  ?degree__label_value
        FILTER ( lang(?degree__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?degree  rdfs:label  ?degree__label_value
        FILTER ( lang(?degree__label_value) = "mul" )
      }
    OPTIONAL
      { ?degree  rdfs:label  ?degree__label_value
        FILTER ( lang(?degree__label_value) = "en" )
      }
    BIND(if(bound(?degree__label_value), ?degree__label_value, if(( isURI(?degree) && strstarts(str(?degree), "http://www.wikidata.org/entity/") ), strafter(str(?degree), "entity/"), str(?degree))) AS ?degreeLabel)
  }

# Original query:
# #title: Map of institutions where Canadian citizens got their PhD
# #defaultView:Map
# SELECT DISTINCT ?institution ?institutionLabel ?academics ?academicsLabel ?degree ?degreeLabel ?geoloc ?image WHERE {
#   ?academics wdt:P31 wd:Q5 ; # instances (P31) of humans (Q5)
#              wdt:P27 wd:Q16 ; # country of citizenship
#              p:P69 ?statement . # check for an "educated at" (P69) statement
#   OPTIONAL { ?academics wdt:P18 ?image }. #image
#
#   ?statement ps:P69 ?institution . # get value of the "educated at" statement, i.e. the institution
#   ?institution wdt:P625 ?geoloc . # get the geolocation of the institution
#
#   ?statement pq:P512 ?degree . # get qualifier "academic degree" (P512)
#   ?degree wdt:P31/wdt:P279* wd:Q849697 . # filter for doctoral degrees
#
#   SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],mul,en". }
#
# }
