# rewrite_status: rewritten
#title: Characters portrayed by most actors
PREFIX  p:    <http://www.wikidata.org/prop/>
PREFIX  pq:   <http://www.wikidata.org/prop/qualifier/>
PREFIX  ps:   <http://www.wikidata.org/prop/statement/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT  ?character ?characterLabel (COUNT(?actor) AS ?count)
WHERE
  { { SELECT DISTINCT  ?character ?actor
      WHERE
        { ?film  p:P161   _:b0 .
          _:b0   ps:P161  ?actor ;
                 pq:P453  ?character
        }
    }
    OPTIONAL
      { ?character  rdfs:label  ?character__label_value
        FILTER ( lang(?character__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?character  rdfs:label  ?character__label_value
        FILTER ( lang(?character__label_value) = "mul" )
      }
    OPTIONAL
      { ?character  rdfs:label  ?character__label_value
        FILTER ( lang(?character__label_value) = "en" )
      }
    BIND(if(bound(?character__label_value), ?character__label_value, if(( isURI(?character) && strstarts(str(?character), "http://www.wikidata.org/entity/") ), strafter(str(?character), "entity/"), str(?character))) AS ?characterLabel)
  }
GROUP BY ?character ?characterLabel
ORDER BY DESC(?count)
LIMIT   25

