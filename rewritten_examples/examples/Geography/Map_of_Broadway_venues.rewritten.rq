# rewrite_status: rewritten
#title: Map of Broadway venues
#defaultView:Map
# Venues in Broadway
PREFIX  geof: <http://www.opengis.net/def/function/geosparql/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX  xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT  ?venue ?venueLabel ?coords
WHERE
  { ?venue    wdt:P1217  ?IDBDB .
    wd:Q235065  wdt:P625  ?broadWayLoc .
    ?venue    wdt:P625   ?coords
    FILTER ( geof:distance(?broadWayLoc, ?coords) <= xsd:decimal("1.5") )
    OPTIONAL
      { ?venue  rdfs:label  ?venue__label_value
        FILTER ( lang(?venue__label_value) = "en" )
      }
    OPTIONAL
      { ?venue  rdfs:label  ?venue__label_value
        FILTER ( lang(?venue__label_value) = "mul" )
      }
    BIND(if(bound(?venue__label_value), ?venue__label_value, if(( isURI(?venue) && strstarts(str(?venue), "http://www.wikidata.org/entity/") ), strafter(str(?venue), "entity/"), str(?venue))) AS ?venueLabel)
  }

