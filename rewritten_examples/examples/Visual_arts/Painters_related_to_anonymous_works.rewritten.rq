# rewrite_status: rewritten
#title: Painters related in some way to any anonymous painting
#defaultView:BubbleChart
PREFIX  p:    <http://www.wikidata.org/prop/>
PREFIX  rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX  wikibase: <http://wikiba.se/ontology#>

SELECT  ?creatorqualifierLabel (COUNT(?creatorqualifier) AS ?count)
WHERE
  { ?item  wdt:P31   wd:Q3305213 ;
           wdt:P170  ?creatorvalue
    FILTER contains(str(?creatorvalue), "wikidata.org/.well-known/genid")
    OPTIONAL
      { ?item     p:P170              ?creatorstatement .
        ?creatorstatement
                  rdf:type            wikibase:BestRank ;
                  ?qualifier          ?creatorqualifier .
        ?qualifierproperty
                  wikibase:qualifier  ?qualifier
      }
    FILTER ( ?qualifierproperty != wd:P3831 )
    BIND(if(bound(?creatorqualifier), ?creatorqualifier, "unbound") AS ?creatorqualifier__label_subject)
    OPTIONAL
      { ?creatorqualifier__label_subject
                  rdfs:label  ?creatorqualifier__label_value
        FILTER ( lang(?creatorqualifier__label_value) = "en" )
      }
    OPTIONAL
      { ?creatorqualifier__label_subject
                  rdfs:label  ?creatorqualifier__label_value
        FILTER ( lang(?creatorqualifier__label_value) = "mul" )
      }
    BIND(if(bound(?creatorqualifier__label_value), ?creatorqualifier__label_value, if(( isURI(?creatorqualifier) && strstarts(str(?creatorqualifier), "http://www.wikidata.org/entity/") ), strafter(str(?creatorqualifier), "entity/"), str(?creatorqualifier))) AS ?creatorqualifierLabel)
  }
GROUP BY ?creatorqualifierLabel
HAVING ( ?count > 2 )
LIMIT   20000

