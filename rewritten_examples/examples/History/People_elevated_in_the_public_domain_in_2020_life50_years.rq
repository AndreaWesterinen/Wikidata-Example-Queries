# rewrite_status: rewritten
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX  wikibase: <http://wikiba.se/ontology#>
PREFIX  xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT  ?item ?itemLabel ?genderLabel (GROUP_CONCAT(DISTINCT ?occupationLabel ; separator=', ') AS ?occupations) (GROUP_CONCAT(DISTINCT ?countryLabel ; separator=', ') AS ?countries) ?death ?articles
WHERE
  { VALUES ?target_country { wd:Q16 wd:Q142 wd:Q39 wd:Q31 wd:Q30 }
    VALUES ?occ { wd:Q2500638 wd:Q20826540 wd:Q215627 }
    ?item  wdt:P31  wd:Q5 ;
           wdt:P21  ?gender ;
           wdt:P27  ?target_country ;
           wdt:P27  ?country .
    ?item wdt:P106/(wdt:P279)* ?occ .
    ?item  wdt:P106            ?occupation ;
           wikibase:sitelinks  ?articles ;
           wdt:P570            ?death
    FILTER ( ( ?death >= "1969-01-01T00:00:00"^^xsd:dateTime ) && ( ?death < "1970-01-01T00:00:00"^^xsd:dateTime ) )
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "fr" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "en" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    BIND(if(bound(?item__label_value), ?item__label_value, if(( isURI(?item) && strstarts(str(?item), "http://www.wikidata.org/entity/") ), strafter(str(?item), "entity/"), str(?item))) AS ?itemLabel)
    OPTIONAL
      { ?gender  rdfs:label  ?gender__label_value
        FILTER ( lang(?gender__label_value) = "fr" )
      }
    OPTIONAL
      { ?gender  rdfs:label  ?gender__label_value
        FILTER ( lang(?gender__label_value) = "en" )
      }
    OPTIONAL
      { ?gender  rdfs:label  ?gender__label_value
        FILTER ( lang(?gender__label_value) = "mul" )
      }
    BIND(if(bound(?gender__label_value), ?gender__label_value, if(( isURI(?gender) && strstarts(str(?gender), "http://www.wikidata.org/entity/") ), strafter(str(?gender), "entity/"), str(?gender))) AS ?genderLabel)
    OPTIONAL
      { ?occupation  rdfs:label  ?occupation__label_value
        FILTER ( lang(?occupation__label_value) = "fr" )
      }
    OPTIONAL
      { ?occupation  rdfs:label  ?occupation__label_value
        FILTER ( lang(?occupation__label_value) = "en" )
      }
    OPTIONAL
      { ?occupation  rdfs:label  ?occupation__label_value
        FILTER ( lang(?occupation__label_value) = "mul" )
      }
    BIND(if(bound(?occupation__label_value), ?occupation__label_value, if(( isURI(?occupation) && strstarts(str(?occupation), "http://www.wikidata.org/entity/") ), strafter(str(?occupation), "entity/"), str(?occupation))) AS ?occupationLabel)
    OPTIONAL
      { ?country  rdfs:label  ?country__label_value
        FILTER ( lang(?country__label_value) = "fr" )
      }
    OPTIONAL
      { ?country  rdfs:label  ?country__label_value
        FILTER ( lang(?country__label_value) = "en" )
      }
    OPTIONAL
      { ?country  rdfs:label  ?country__label_value
        FILTER ( lang(?country__label_value) = "mul" )
      }
    BIND(if(bound(?country__label_value), ?country__label_value, if(( isURI(?country) && strstarts(str(?country), "http://www.wikidata.org/entity/") ), strafter(str(?country), "entity/"), str(?country))) AS ?countryLabel)
  }
GROUP BY ?item ?itemLabel ?genderLabel ?death ?articles
ORDER BY DESC(?articles)

