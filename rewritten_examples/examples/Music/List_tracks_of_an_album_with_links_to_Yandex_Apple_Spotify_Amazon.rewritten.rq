# rewrite_status: rewritten
#title: List tracks of an album, with links to Yandex, Apple, Spotify, Amazon
PREFIX  p:    <http://www.wikidata.org/prop/>
PREFIX  pq:   <http://www.wikidata.org/prop/qualifier/>
PREFIX  ps:   <http://www.wikidata.org/prop/statement/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX  xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT  ?order ?item ?itemLabel ?yandex ?apple (URI(concat("https://open.spotify.com/track/", ?spotify_id)) AS ?spotify) (URI(concat("https://www.amazon.com/dp/", ?amazon_id)) AS ?amazon)
WHERE
  { wd:Q105834355
              p:P658   ?st .
    ?st       ps:P658  ?item
    OPTIONAL
      { ?st  pq:P1545  ?order }
    OPTIONAL
      { ?item  p:P750    _:b0 .
        _:b0   ps:P750   wd:Q4537983 ;
               pq:P2699  ?yandex
      }
    OPTIONAL
      { ?item  p:P750    _:b1 .
        _:b1   ps:P750   wd:Q20056642 ;
               pq:P2699  ?apple
      }
    OPTIONAL
      { ?item  wdt:P5749  ?amazon_id }
    OPTIONAL
      { ?item  wdt:P2207  ?spotify_id }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "ru" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "en" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    BIND(if(bound(?item__label_value), ?item__label_value, if(( isURI(?item) && strstarts(str(?item), "http://www.wikidata.org/entity/") ), strafter(str(?item), "entity/"), str(?item))) AS ?itemLabel)
  }
ORDER BY xsd:integer(?order)

# Original query:
