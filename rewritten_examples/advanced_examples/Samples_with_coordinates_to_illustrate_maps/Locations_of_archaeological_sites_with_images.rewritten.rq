# rewrite_status: rewritten
#defaultView:Map
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?siteLabel ?coord ?image ?site
WHERE
  { ?site wdt:P31/(wdt:P279)* wd:Q839954 .
    ?site  wdt:P625  ?coord ;
           wdt:P18   ?image
    OPTIONAL
      { ?site  rdfs:label  ?site__label_value
        FILTER ( lang(?site__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?site  rdfs:label  ?site__label_value
        FILTER ( lang(?site__label_value) = "en" )
      }
    OPTIONAL
      { ?site  rdfs:label  ?site__label_value
        FILTER ( lang(?site__label_value) = "mul" )
      }
    BIND(if(bound(?site__label_value), ?site__label_value, if(( isURI(?site) && strstarts(str(?site), "http://www.wikidata.org/entity/") ), strafter(str(?site), "entity/"), str(?site))) AS ?siteLabel)
  }

