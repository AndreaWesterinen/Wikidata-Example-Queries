# rewrite_status: rewritten
#title: Most famous child of a librarian
# Children of librarians with the most number of sitelinks (as a proxy for fame)
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX  wikibase: <http://wikiba.se/ontology#>

SELECT  ?person ?personLabel ?parentLabel ?linkcount
WHERE
  { ?parent  wdt:P106            wd:Q182436 ;
             wdt:P40             ?person .
    ?person  wikibase:sitelinks  ?linkcount
    OPTIONAL
      { ?person  rdfs:label  ?person__label_value
        FILTER ( lang(?person__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?person  rdfs:label  ?person__label_value
        FILTER ( lang(?person__label_value) = "mul" )
      }
    OPTIONAL
      { ?person  rdfs:label  ?person__label_value
        FILTER ( lang(?person__label_value) = "en" )
      }
    OPTIONAL
      { ?person  rdfs:label  ?person__label_value
        FILTER ( lang(?person__label_value) = "de" )
      }
    OPTIONAL
      { ?person  rdfs:label  ?person__label_value
        FILTER ( lang(?person__label_value) = "es" )
      }
    OPTIONAL
      { ?person  rdfs:label  ?person__label_value
        FILTER ( lang(?person__label_value) = "ar" )
      }
    OPTIONAL
      { ?person  rdfs:label  ?person__label_value
        FILTER ( lang(?person__label_value) = "fr" )
      }
    BIND(if(bound(?person__label_value), ?person__label_value, if(( isURI(?person) && strstarts(str(?person), "http://www.wikidata.org/entity/") ), strafter(str(?person), "entity/"), str(?person))) AS ?personLabel)
    OPTIONAL
      { ?parent  rdfs:label  ?parent__label_value
        FILTER ( lang(?parent__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?parent  rdfs:label  ?parent__label_value
        FILTER ( lang(?parent__label_value) = "mul" )
      }
    OPTIONAL
      { ?parent  rdfs:label  ?parent__label_value
        FILTER ( lang(?parent__label_value) = "en" )
      }
    OPTIONAL
      { ?parent  rdfs:label  ?parent__label_value
        FILTER ( lang(?parent__label_value) = "de" )
      }
    OPTIONAL
      { ?parent  rdfs:label  ?parent__label_value
        FILTER ( lang(?parent__label_value) = "es" )
      }
    OPTIONAL
      { ?parent  rdfs:label  ?parent__label_value
        FILTER ( lang(?parent__label_value) = "ar" )
      }
    OPTIONAL
      { ?parent  rdfs:label  ?parent__label_value
        FILTER ( lang(?parent__label_value) = "fr" )
      }
    BIND(if(bound(?parent__label_value), ?parent__label_value, if(( isURI(?parent) && strstarts(str(?parent), "http://www.wikidata.org/entity/") ), strafter(str(?parent), "entity/"), str(?parent))) AS ?parentLabel)
  }
GROUP BY ?linkcount ?person ?personLabel ?parent ?parentLabel
ORDER BY DESC(?linkcount)

