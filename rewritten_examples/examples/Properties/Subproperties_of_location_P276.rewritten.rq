# rewrite_status: rewritten
#title: Subproperties of location (P276)
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT DISTINCT  ?subProperties ?subPropertiesLabel
WHERE
  { ?subProperties (wdt:P1647)* wd:P276
    OPTIONAL
      { ?subProperties
                  rdfs:label  ?subProperties__label_value
        FILTER ( lang(?subProperties__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?subProperties
                  rdfs:label  ?subProperties__label_value
        FILTER ( lang(?subProperties__label_value) = "mul" )
      }
    OPTIONAL
      { ?subProperties
                  rdfs:label  ?subProperties__label_value
        FILTER ( lang(?subProperties__label_value) = "en" )
      }
    BIND(if(bound(?subProperties__label_value), ?subProperties__label_value, if(( isURI(?subProperties) && strstarts(str(?subProperties), "http://www.wikidata.org/entity/") ), strafter(str(?subProperties), "entity/"), str(?subProperties))) AS ?subPropertiesLabel)
  }

# Original query:
# #title: Subproperties of location (P276)
# SELECT DISTINCT ?subProperties ?subPropertiesLabel WHERE {
#   ?subProperties wdt:P1647* wd:P276.
#   SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],mul,en". }
# }
