#   ?item p:P3602 ?node.
#   ?item wdt:P21 ?gender.
#   ?item wdt:P106 ?occupation.
#   ?node ps:P3602 wd:Q16061881.
#   ?node pq:P10777 ?positie_op_lijst.
#   ?node pq:P1268 ?politieke_partij.
#   SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],nl". }
# }
