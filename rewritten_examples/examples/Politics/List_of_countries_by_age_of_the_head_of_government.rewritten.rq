# rewrite_status: rewritten
#title: List of countries by age of the head of government
#added by Jura1, rev. 2016-11-08
PREFIX  p:    <http://www.wikidata.org/prop/>
PREFIX  pq:   <http://www.wikidata.org/prop/qualifier/>
PREFIX  ps:   <http://www.wikidata.org/prop/statement/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT DISTINCT  ?age ?country ?countryLabel ?hgovernment ?hgovernmentLabel
WHERE
  { ?country  wdt:P31  wd:Q3624078
    FILTER NOT EXISTS { ?country  wdt:P31  wd:Q3024240 }
    ?country  p:P6    ?statement .
    ?statement  ps:P6  ?hgovernment .
    ?country  wdt:P6  ?hgovernment
    FILTER NOT EXISTS { ?statement  pq:P582  ?x }
    ?hgovernment  wdt:P569  ?dob
    BIND(( year(now()) - year(?dob) ) AS ?age)
    FILTER ( ?age >= 65 )
    OPTIONAL
      { ?country  rdfs:label  ?country__label_value
        FILTER ( lang(?country__label_value) = "en" )
      }
    OPTIONAL
      { ?country  rdfs:label  ?country__label_value
        FILTER ( lang(?country__label_value) = "mul" )
      }
    BIND(if(bound(?country__label_value), ?country__label_value, if(( isURI(?country) && strstarts(str(?country), "http://www.wikidata.org/entity/") ), strafter(str(?country), "entity/"), str(?country))) AS ?countryLabel)
    OPTIONAL
      { ?hgovernment  rdfs:label  ?hgovernment__label_value
        FILTER ( lang(?hgovernment__label_value) = "en" )
      }
    OPTIONAL
      { ?hgovernment  rdfs:label  ?hgovernment__label_value
        FILTER ( lang(?hgovernment__label_value) = "mul" )
      }
    BIND(if(bound(?hgovernment__label_value), ?hgovernment__label_value, if(( isURI(?hgovernment) && strstarts(str(?hgovernment), "http://www.wikidata.org/entity/") ), strafter(str(?hgovernment), "entity/"), str(?hgovernment))) AS ?hgovernmentLabel)
  }
ORDER BY DESC(?age)

