# rewrite_status: rewritten
# Human settlements without an article in the English Wikipedia
#defaultView:Map
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  schema: <http://schema.org/>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT DISTINCT  ?settlement ?settlementLabel ?coor
WHERE
  { VALUES ?type { wd:Q3957 wd:Q515 wd:Q532 wd:Q486972 }
    ?settlement  wdt:P31    wd:Q3957 ;
              wdt:P625      ?coor .
    ?article  schema:about  ?settlement
    FILTER NOT EXISTS { ?wen  schema:about       ?settlement ;
                              schema:inLanguage  "en"
                      }
    OPTIONAL
      { ?settlement  rdfs:label  ?settlement__label_value
        FILTER ( lang(?settlement__label_value) = "en" )
      }
    OPTIONAL
      { ?settlement  rdfs:label  ?settlement__label_value
        FILTER ( lang(?settlement__label_value) = "mul" )
      }
    BIND(if(bound(?settlement__label_value), ?settlement__label_value, if(( isURI(?settlement) && strstarts(str(?settlement), "http://www.wikidata.org/entity/") ), strafter(str(?settlement), "entity/"), str(?settlement))) AS ?settlementLabel)
  }

# Original query:
# # Human settlements without an article in the English Wikipedia
# #defaultView:Map
# SELECT DISTINCT ?settlement ?settlementLabel ?coor WHERE {
#   VALUES ?type {wd:Q3957 wd:Q515 wd:Q532 wd:Q486972}
#   ?settlement wdt:P31 wd:Q3957 ;
#               wdt:P625 ?coor .   
#   ?article schema:about ?settlement .
#   FILTER NOT EXISTS { ?wen schema:about ?settlement ; schema:inLanguage "en" }
#   SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
# }
