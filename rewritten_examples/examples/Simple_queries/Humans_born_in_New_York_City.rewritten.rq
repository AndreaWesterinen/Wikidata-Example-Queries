# rewrite_status: rewritten
#title: Humans born in New York City
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  schema: <http://schema.org/>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX  wikibase: <http://wikiba.se/ontology#>

SELECT DISTINCT  ?item ?itemLabel ?itemDescription ?sitelinks
WHERE
  { ?item  wdt:P31  wd:Q5 .
    ?item wdt:P19/(wdt:P131)* wd:Q60 .
    ?item  wikibase:sitelinks  ?sitelinks
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "en" )
      }
    BIND(if(bound(?item__label_value), ?item__label_value, if(( isURI(?item) && strstarts(str(?item), "http://www.wikidata.org/entity/") ), strafter(str(?item), "entity/"), str(?item))) AS ?itemLabel)
    OPTIONAL
      { ?item  schema:description  ?item__description_value
        FILTER ( lang(?item__description_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?item  schema:description  ?item__description_value
        FILTER ( lang(?item__description_value) = "en" )
      }
    BIND(?item__description_value AS ?itemDescription)
  }
ORDER BY DESC(?sitelinks)
LIMIT   500

# Original query:
# #title: Humans born in New York City
# SELECT DISTINCT ?item ?itemLabel ?itemDescription ?sitelinks
# WHERE {
#     ?item wdt:P31 wd:Q5;            # Any instance of a human
#           wdt:P19/wdt:P131* wd:Q60; # who was declared born in New York City itself
# # or in any value (eg. a hospital) that has the property of 'administrative area of' New York City.
#           wikibase:sitelinks ?sitelinks.
#
# # Note that using only wdt:P19 wd:Q60;  # 'who was born in New York City'
# # doesn't include humans with the birth place listed as a hospital
# # or an administrative area or other location of New York City.
#
#     SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],mul,en" }
# }
# ORDER BY DESC(?sitelinks)
# LIMIT 500
#
# # *****  If error, try again  *****
